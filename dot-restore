#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=/dev/null
source "$HOME/bin/lib/dot-common.sh"

DRY_RUN=0

usage() {
  cat <<'EOM'
Usage: dot-restore [--dry-run]
LINK-ONLY: make each managed $HOME path a symlink to its repo file
(managed/home/<path>). The repo is the source of truth.

For each manifest entry:
  - already the correct link  -> no-op
  - a real file / wrong link  -> move it to ~/.dotfiles-backups/<timestamp>/<rel>,
                                 then create the symlink
Never touches SSH private keys or files containing a PRIVATE KEY header.

Options:
  --dry-run   Print what would happen, make no changes
EOM
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=1 ;;
    -h|--help) usage; exit 0 ;;
    *) die "Unknown arg: $1" ;;
  esac
  shift
done

ensure_repo
ensure_manifest

ts="$(date +%Y%m%d-%H%M%S)"
backup_root="$DOT_BACKUP_DIR/$ts"
made_backup=0

count=0 linked=0 already=0 skipped=0 missing=0
declare -a missing_privkeys=()

while IFS=$'\t' read -r _mode abs; do
  count=$((count+1))

  # A managed *.pub is only usable if its PRIVATE counterpart exists locally.
  # Private keys are never managed (safety belt), so on a fresh machine the pubs
  # link but the private halves are absent — collect those to report at the end.
  if [[ "$abs" == *.pub && ! -e "${abs%.pub}" ]]; then
    missing_privkeys+=("${abs%.pub}")
  fi

  if is_ssh_private_key "$abs"; then
    warn "[$count] skipping protected (private/secret): $abs"
    skipped=$((skipped+1))
    continue
  fi

  tgt="$(repo_target_for "$abs")"
  if [[ ! -e "$tgt" ]]; then
    warn "[$count] REPO missing (cannot link): $tgt"
    missing=$((missing+1))
    continue
  fi

  # Already the correct link?
  if [[ -L "$abs" && -e "$abs" && "$(readlink "$abs")" == "$tgt" ]]; then
    log "[$count] already linked: $abs"
    already=$((already+1))
    continue
  fi

  log "[$count] link: $abs -> $tgt"

  if [[ $DRY_RUN -eq 1 ]]; then
    if [[ -e "$abs" || -L "$abs" ]]; then
      log "        (would back up existing -> $backup_root${abs#"$HOME"})"
    fi
    linked=$((linked+1))
    continue
  fi

  mkdir -p "$(dirname "$abs")"

  # Move any existing live file/link out of the way first.
  if [[ -e "$abs" || -L "$abs" ]]; then
    bkp="$backup_root${abs#"$HOME"}"
    mkdir -p "$(dirname "$bkp")"
    mv "$abs" "$bkp"
    made_backup=1
    log "        (backed up existing -> $bkp)"
  fi

  ln -s "$tgt" "$abs"
  linked=$((linked+1))
done < <(read_manifest_expanded)

log ""
log "Linked: $linked | Already-linked: $already | Repo-missing: $missing | Skipped(secret): $skipped | Total: $count"
if [[ $DRY_RUN -eq 0 && $made_backup -eq 1 ]]; then
  log "Backups of replaced files saved under: $backup_root"
fi

# Fresh-machine action list: managed public keys whose private key is absent.
# Private keys are never in the repo, so these must be generated or restored from
# a secure backup before the linked *.pub files are usable (e.g. SSH auth).
if [[ ${#missing_privkeys[@]} -gt 0 ]]; then
  log ""
  warn "ACTION NEEDED: ${#missing_privkeys[@]} managed public key(s) have no local private key."
  warn "Generate a new keypair (ssh-keygen -t ed25519 -f <path>) or restore the private key from a secure backup:"
  for _pk in "${missing_privkeys[@]}"; do
    warn "  - missing private key: $_pk   (public key: ${_pk}.pub)"
  done
fi
