#!/usr/bin/env bash
set -euo pipefail

# git-ai-commit: DevSecOps-minded commit message generator for STAGED changes
#
# Backend selection:
#   AI_BACKEND=codex|claude   (default: codex)
#
# Backend env:
#   Codex:
#     CODEX_CMD   (default: codex)
#     CODEX_ARGS  (default: exec --color never -)
#   Claude (Anthropic CLI):
#     CLAUDE_CMD  (default: claude)
#     CLAUDE_ARGS (default: -p)   # reads prompt from stdin; prints completion to stdout
#
# Behavior:
# - If NO staged changes:
#     - Warns clearly
#     - If there are working-tree changes, offers to "git add -A" (with confirmation)
#     - Then proceeds (or exits if declined)
# - If staged changes exist:
#     - Proceeds normally
# - Generates a commit message for STAGED changes.
# - If the generated message is malformed (bad subject / invalid JSON), it is
#   REGENERATED with a corrective hint, up to AI_MAX_ATTEMPTS times (default 3),
#   before aborting. Each retry prints a human-readable reason and a banner.
# - Shows it with separators (colorized if TTY).
# - Prompts for confirmation, then runs: git commit -F - (optionally --no-verify).
#
# Logging / timestamps:
# - stdout carries ONLY the payload: the generated commit message (piped to
#   `git commit -F -`) or the --json object. It is never timestamped or altered.
# - stderr carries all diagnostic/progress output. When timestamps are enabled,
#   every stderr line is prefixed with an RFC 3339 / ISO 8601 UTC timestamp
#   (millisecond precision) so CI systems and log aggregators can parse and
#   correlate timing.
# - Control:
#     AI_LOG_TS=auto|1|0            (default: auto -> on when stderr is NOT a TTY)
#     --timestamps / --no-timestamps  (override AI_LOG_TS for this run)
#
# Requirements:
# - jq is required (always).
# - perl is required (already used below; also powers the timestamper, which is
#   portable across macOS (BSD date lacks %N) and Linux).
#
# Notes:
# - Cleans tool output (removes "tokens used" footer, repeats, and rollback section if emitted).
# - The blocking secret-scan gate inspects ADDED lines only — deletions can
#   neither leak a secret to the backend nor introduce one into the new tree.
# - On a malformed message, regenerates up to AI_MAX_ATTEMPTS times (default 3)
#   with a corrective hint before aborting; retries are never silent.
# - In --json mode, prints raw JSON only (no separators) and does NOT auto-commit.

source "$(dirname "$0")/lib/git-ai-common.sh"

# Timestamp state (resolved after arg parsing / preflight, below).
TS_ON=0
TS_SINK_PID=""

usage() {
  cat <<EOF
git ai-commit [--full] [--json] [--no-verify] [--no-commit] [--yes]
              [--timestamps | --no-timestamps] [--allow-secret-matches]

Generates a DevSecOps-minded commit message for changes.

Backends:
  AI_BACKEND=codex   Uses: \$CODEX_CMD \$CODEX_ARGS
  AI_BACKEND=claude  Uses: \$CLAUDE_CMD \$CLAUDE_ARGS

Options:
  --full            Add extra DevSecOps checklist questions
  --json            Request JSON output (requires jq; validates output). Does NOT auto-commit.
  --no-verify       Pass --no-verify to git commit
  --no-commit       Do not run git commit (print only)
  --yes             Skip commit confirmation prompt (still may prompt to stage if nothing staged)
  --timestamps      Prefix stderr log lines with RFC 3339 UTC timestamps (machine-parseable)
  --no-timestamps   Never prefix stderr log lines with timestamps
  --print-prompt    Build the backend prompt, print it to stdout, and exit (no backend call, no commit)
  --allow-secret-matches
                    Proceed even if the staged diff matches secret patterns. The staged
                    diff (including the matched lines) is then transmitted to the AI
                    backend. Use ONLY for confirmed false positives.
  -h, --help        Show help

Environment:
  AI_MAX_ATTEMPTS   Total generation attempts before aborting on a malformed
                    message (default 3). On each failure the message is
                    regenerated with a corrective hint naming what was wrong.

Logging:
  Diagnostic/progress output goes to stderr; the commit message (or --json
  payload) goes to stdout and is left byte-clean. Machine-parseable timestamps
  are controlled by AI_LOG_TS=auto|1|0 (default auto: on when stderr is not a
  TTY) or by --timestamps / --no-timestamps.
EOF
}

print_commit_block() {
  local content="$1"
  local line="────────────────────────────────────────────────────────────"
  local title="AI-Generated Commit Message"
  local meta="Backend: ${AI_BACKEND}"

  if (( COLOR_ON == 1 )); then
    printf "%s\n" "$(c 'setaf 4' "$line")"
    printf "%s\n" "$(c 'bold' "$title")"
    printf "%s\n" "$(c 'setaf 8' "$meta")"
    printf "%s\n\n" "$(c 'setaf 4' "$line")"
  else
    printf "%s\n%s\n%s\n%s\n\n" "$line" "$title" "$meta" "$line"
  fi

  printf "%s\n\n" "$content"

  if (( COLOR_ON == 1 )); then
    printf "%s\n" "$(c 'setaf 4' "$line")"
  else
    printf "%s\n" "$line"
  fi
}

# ---------- trailing-chatter guard (TEXT mode only) --------------------------
# The AI backends sometimes append conversational meta-commentary AFTER an
# otherwise well-formed commit message — offers to run the commit, questions,
# or "Note:" asides that critique the message/format itself. clean_ai_output()
# (in lib) strips footers ("tokens used", code fences, rollback notes) but NOT
# this trailing chatter, so without a guard it would be committed verbatim by
# `git commit -F -`. JSON mode is already protected by the jq validation below;
# only TEXT mode needs this.
#
# The guard removes ONLY trailing, blank-line-separated paragraphs that match a
# known chatter shape, iterating from the end and stopping at the first trailing
# paragraph that looks like real content. It NEVER touches the subject, body
# bullets, or interior sections (Security/DevSecOps Impact:, Testing:) — a
# paragraph is eligible only while it is the very LAST paragraph of the message.
#
# Legitimate-vs-chatter distinction: a trailing "Notes:" paragraph that
# describes the CHANGE (e.g. "Notes: migration requires re-running setup on the
# Pi runner.") must survive byte-identically. The Note heuristic therefore fires
# only when the paragraph ALSO references the message/format itself — describing
# the change alone is never enough to strip it. When unsure, the guard keeps the
# paragraph; false negatives (a stray line committed) are safer than corrupting
# a valid message.

# _is_chatter_paragraph <paragraph> — returns 0 (true) if the paragraph is
# trailing backend chatter, else 1. All patterns live in this one block so the
# heuristic is easy to audit and extend.
_is_chatter_paragraph() {
  local p="$1"
  local t="$p"

  # Trim leading/trailing whitespace (incl. newlines) for the suffix/prefix tests.
  while [[ "$t" == [[:space:]]* ]]; do t="${t#?}"; done
  while [[ "$t" == *[[:space:]] ]]; do t="${t%?}"; done

  # ---- chatter pattern block (extend here) --------------------------------
  # 1. Direct offers to act, or requests for direction, anywhere in the block.
  if printf '%s' "$p" | grep -q -i -E 'Want me to|Would you like|Shall I|Let me know|If you want' 2>/dev/null; then
    return 0
  fi
  # 2. A paragraph whose final sentence is a question (ends in "?"). Real commit
  #    sections (bullets, "Security/DevSecOps Impact:", "Testing:") never do.
  if [[ "$t" == *'?' ]]; then
    return 0
  fi
  # 3. A "Note"/"Note:" aside that comments on the MESSAGE or its FORMAT rather
  #    than the change. Requires BOTH a leading Note* AND a message/format
  #    reference, so a legitimate "Notes:" about the change is left untouched.
  if printf '%s' "$t" | grep -q -i -E '^Note' 2>/dev/null \
     && printf '%s' "$p" | grep -q -i -E 'the message|one-line form|strict form|commit message' 2>/dev/null; then
    return 0
  fi
  # ---- end chatter pattern block ------------------------------------------

  return 1
}

# strip_trailing_chatter <message> — prints the cleaned message to stdout. If
# any trailing paragraph was stripped, also prints a labeled warning showing the
# removed text verbatim to stderr. Always returns 0, so it is safe under
# `set -euo pipefail` and inside a command substitution.
strip_trailing_chatter() {
  local msg="$1"
  local removed=""
  local last head head_len

  while :; do
    # Isolate the last blank-line-separated paragraph. With no blank-line gap
    # remaining, `##*\n\n` returns the whole string unchanged -> only one
    # paragraph is left, so we stop (the subject is never eligible).
    last="${msg##*$'\n\n'}"
    [[ "$last" == "$msg" ]] && break   # RHS quoted -> literal compare, no globbing

    if _is_chatter_paragraph "$last"; then
      # Prepend so the warning shows removed paragraphs in original order.
      removed="${last}${removed:+$'\n\n'}${removed}"
      head_len=$(( ${#msg} - ${#last} ))
      head="${msg:0:$head_len}"
      # Drop the trailing blank-line separator we split on.
      while [[ "$head" == *$'\n' ]]; do head="${head%$'\n'}"; done
      msg="$head"
    else
      break
    fi
  done

  if [[ -n "$removed" ]]; then
    {
      printf '\n'
      echo "WARNING: Stripped trailing backend chatter (NOT committed):"
      echo "----- BEGIN STRIPPED CHATTER -----"
      printf '%s\n' "$removed"
      echo "----- END STRIPPED CHATTER -----"
      printf '\n'
    } >&2
  fi

  printf '%s' "$msg"
  return 0
}

# ---------- structural subject validation (TEXT mode only) -------------------
# JSON mode is validated by jq below; TEXT mode is piped verbatim into
# `git commit -F -`, so its FIRST line must be a real Conventional Commit
# subject. Validating structurally (rather than salvaging) categorically catches
# leading chatter, refusals, and fenced/wrapped output without a pattern list:
# anything whose first line is not a subject is rejected outright.
#
# Subject contract — matches what OUTPUT_FORMAT_TEXT / the prompt already ask for:
#   ^[a-z]+(\([^)]*\))?(!)?: .+     lowercase type, optional (scope), optional
#                                   "!", a ": " separator, then a non-empty desc
#   length <= 72 characters
#
# _is_valid_subject <line> — returns 0 (valid) / 1 (invalid). No output.
_is_valid_subject() {
  local line="$1"
  # Length gate first (Conventional Commit subject must be <= 72 chars).
  (( ${#line} <= 72 )) || return 1
  # Structural gate. ERE: '!' is a literal here (not special in grep -E).
  printf '%s' "$line" | grep -q -E '^[a-z]+(\([^)]*\))?(!)?: .+' || return 1
  return 0
}

# _subject_failure_reason <line> — one short, human-readable sentence naming WHY
# a subject failed _is_valid_subject, so both retry banners and the final abort
# say something actionable ("subject is 79 characters (limit is 72)") instead of
# echoing a bare regex. Mirrors the gate order in _is_valid_subject.
_subject_failure_reason() {
  local line="$1"
  if (( ${#line} > 72 )); then
    printf 'subject is %d characters (limit is 72)' "${#line}"
  elif ! printf '%s' "$line" | grep -q -E '^[a-z]+(\([^)]*\))?(!)?: .+'; then
    printf 'first line is not a Conventional Commit subject (need "type(scope): description")'
  else
    printf 'subject failed validation'
  fi
}

# _warn_retry <attempt_done> <max> <reason> — loud, human-readable banner shown
# on stderr before each regeneration so a retry is never silent. Names the
# attempt number, the reason the last attempt was rejected, and what happens
# next.
_warn_retry() {
  local done_n="$1" max_n="$2" reason="$3"
  local line="────────────────────────────────────────────────────────────"
  {
    if (( COLOR_ON == 1 )); then
      printf "%s\n" "$(c 'setaf 3' "$line")"
      printf "%s\n" "$(c 'bold' "RETRY — regenerating commit message (attempt $((done_n + 1))/${max_n})")"
      printf "%s\n" "$(c 'setaf 3' "$line")"
    else
      printf "%s\n%s\n%s\n" "$line" "RETRY — regenerating commit message (attempt $((done_n + 1))/${max_n})" "$line"
    fi
    printf "Previous attempt (%d/%d) was rejected: %s\n" "$done_n" "$max_n" "$reason"
    printf "Re-asking the %s backend with a corrective hint...\n" "${AI_BACKEND:-codex}"
  } >&2
}

confirm_yn() {
  local prompt="$1"
  local reply=""
  if [[ -t 0 ]]; then
    # Write the prompt to fd 3 (the raw, un-timestamped stderr) so it reaches the
    # terminal immediately. Routing it through the line-buffered timestamper on
    # fd 2 would hold the prompt (no trailing newline) until the next log line
    # flushed it — printing it late and glued to that line. Then read the reply.
    printf '%s' "$prompt" >&3
    read -r reply || true
    [[ "$reply" == "y" || "$reply" == "Y" ]]
  else
    return 1
  fi
}

confirm_commit() {
  confirm_yn "Commit with the message above? [y/N] "
}

# ---------- spinner (phased animated wheel) ----------
SPINNER_PID=""
SPINNER_LABEL=""
SPINNER_ACTIVE=0

spinner_can_run() {
  # Animate only when stderr is a TTY (keeps stdout clean for --json), and never
  # while timestamped logging is active: line-prefixing the wheel's carriage
  # returns / cursor control would corrupt both the animation and the log.
  [[ -t 2 ]] && (( TS_ON == 0 ))
}

spinner_start() {
  local label="${1:-Working…}"
  spinner_can_run || return 0

  spinner_stop

  SPINNER_LABEL="$label"
  SPINNER_ACTIVE=1

  # Hide cursor (best effort)
  tput civis >/dev/null 2>&1 || true

  (
    local frames=( "⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏" )
    local i=0
    while :; do
      printf "\r%s %s" "${frames[i]}" "$SPINNER_LABEL" >&2
      i=$(( (i + 1) % ${#frames[@]} ))
      sleep 0.08
    done
  ) &
  SPINNER_PID="$!"
}

spinner_update() {
  local label="${1:-Working…}"
  (( SPINNER_ACTIVE == 1 )) || return 0
  SPINNER_LABEL="$label"
}

spinner_stop() {
  if [[ -n "${SPINNER_PID:-}" ]]; then
    kill "$SPINNER_PID" >/dev/null 2>&1 || true
    wait "$SPINNER_PID" >/dev/null 2>&1 || true
    SPINNER_PID=""
  fi
  if (( SPINNER_ACTIVE == 1 )); then
    printf "\r\033[2K" >&2
    tput cnorm >/dev/null 2>&1 || true
    SPINNER_ACTIVE=0
  fi
}

# -----------------------------------------------------------------------------
# Ctrl-C / SIGTERM handling
# - Ensure spinner stops
# - Ensure any in-flight backend command launched by run_with_wheel is terminated
# - Exit immediately with code 130 so callers/spinners don't hang
# -----------------------------------------------------------------------------
RUN_WHEEL_JOB_PID=""
TMP_RAW=""
TMP_CLEAN=""

_cleanup_temp() {
  rm -f "${TMP_RAW:-}" "${TMP_CLEAN:-}" >/dev/null 2>&1 || true
  TMP_RAW=""
  TMP_CLEAN=""
}

# Flush and detach the stderr timestamper (if active) so no trailing log line is
# dropped, and any later writes go straight to the real stderr. Closing fd 2's
# pipe write-end (via `exec 2>&3 3>&-`) sends EOF to perl, which then drains.
_stop_ts_sink() {
  if [[ -n "${TS_SINK_PID:-}" ]]; then
    exec 2>&3 3>&- || true
    wait "${TS_SINK_PID}" 2>/dev/null || true
    TS_SINK_PID=""
  fi
}

_on_interrupt() {
  # Stop the UI immediately
  spinner_stop

  # If the backend/clean command is running, interrupt it and wait it out
  if [[ -n "${RUN_WHEEL_JOB_PID:-}" ]]; then
    kill -INT "${RUN_WHEEL_JOB_PID}" >/dev/null 2>&1 || true
    wait "${RUN_WHEEL_JOB_PID}" >/dev/null 2>&1 || true
    RUN_WHEEL_JOB_PID=""
  fi

  _cleanup_temp

  # Ensure cursor is visible
  tput cnorm >/dev/null 2>&1 || true

  # Exit now with standard SIGINT exit code (triggers EXIT trap -> flushes sink)
  exit 130
}

_on_exit() {
  spinner_stop
  _cleanup_temp
  tput cnorm >/dev/null 2>&1 || true
  # Flush the stderr timestamper LAST so every diagnostic line it received is
  # emitted before the process exits.
  _stop_ts_sink
}

trap _on_interrupt INT TERM
trap _on_exit EXIT

# Respect QUIET + tty for spinner usage
spinner_maybe_start() {
  local label="$1"
  if (( QUIET == 0 )) && spinner_can_run; then
    spinner_start "$label"
  fi
}

spinner_maybe_stop() {
  if (( QUIET == 0 )) && spinner_can_run; then
    spinner_stop
  fi
}

# Usage:
#   run_with_wheel_to_file "Calling codex…" /path/to/out.txt run_ai "$PROMPT"
run_with_wheel_to_file() {
  local label="$1"; shift
  local outfile="$1"; shift
  local rc=0

  : >"$outfile"

  if (( QUIET == 0 )) && spinner_can_run; then
    spinner_start "$label"
  fi

  (
    "$@"
  ) >"$outfile" 2>&1 &
  RUN_WHEEL_JOB_PID="$!"

  wait "$RUN_WHEEL_JOB_PID" || rc=$?
  RUN_WHEEL_JOB_PID=""

  if (( QUIET == 0 )) && spinner_can_run; then
    spinner_stop
  fi

  return "$rc"
}

# ---------- flags ----------
FULL=0
JSON_OUT=0
NO_VERIFY=0
NO_COMMIT=0
YES=0
AUTO_STAGED=0
TS_FORCE=""   # empty = defer to AI_LOG_TS; 1 = force on; 0 = force off
PRINT_PROMPT=0
ALLOW_SECRET_MATCHES=0

while (( $# > 0 )); do
  case "$1" in
    --full) FULL=1; shift ;;
    --json) JSON_OUT=1; shift ;;
    --no-verify) NO_VERIFY=1; shift ;;
    --no-commit) NO_COMMIT=1; shift ;;
    --yes) YES=1; shift ;;
    --timestamps) TS_FORCE=1; shift ;;
    --no-timestamps) TS_FORCE=0; shift ;;
    --print-prompt) PRINT_PROMPT=1; shift ;;
    --allow-secret-matches) ALLOW_SECRET_MATCHES=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "Unknown arg: $1" ;;
  esac
done

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "Not in a git repo."

preflight_check git jq grep head perl awk

# Regeneration budget: total generation attempts (1 initial + retries) before we
# abort on a malformed message. Must be a positive integer.
MAX_ATTEMPTS="${AI_MAX_ATTEMPTS:-3}"
[[ "$MAX_ATTEMPTS" =~ ^[1-9][0-9]*$ ]] \
  || die "AI_MAX_ATTEMPTS must be a positive integer (got: '${MAX_ATTEMPTS}')."

# ---------- resolve + install machine-parseable timestamps ----------
# Precedence: --timestamps/--no-timestamps (TS_FORCE) overrides AI_LOG_TS; the
# default (auto) turns timestamps ON only when stderr is not a TTY, i.e. when a
# machine is capturing the log rather than a human watching a terminal.
case "${TS_FORCE:-}" in
  1) TS_ON=1 ;;
  0) TS_ON=0 ;;
  *) case "${AI_LOG_TS:-auto}" in
       1|true|yes|on)  TS_ON=1 ;;
       0|false|no|off) TS_ON=0 ;;
       auto|*)         if [[ -t 2 ]]; then TS_ON=0; else TS_ON=1; fi ;;
     esac ;;
esac

# Preserve the real, un-timestamped stderr on fd 3 in ALL cases. Interactive
# prompts (confirm_yn) and anything that must reach the user in real time write
# to fd 3 so they are never held or reformatted by the timestamper on fd 2.
exec 3>&2

if (( TS_ON == 1 )); then
  # Funnel fd 2 through a single perl process that prefixes every line with an
  # RFC 3339 UTC millisecond timestamp. perl writes to its stdout, redirected to
  # fd 3 (the real stderr), so there is no feedback loop. This stamps ALL stderr
  # uniformly — phase steps, info lines, warnings, and any captured backend error
  # dumps — with one cheap long-lived process (no per-line fork).
  exec 2> >(perl -MTime::HiRes=time -e '
    $| = 1;
    while (my $line = <STDIN>) {
      my $t = time;
      my @g = gmtime($t);
      printf "%04d-%02d-%02dT%02d:%02d:%02d.%03dZ %s",
        $g[5] + 1900, $g[4] + 1, $g[3], $g[2], $g[1], $g[0],
        ($t - int($t)) * 1000, $line;
    }
  ' >&3)
  TS_SINK_PID=$!
fi

QUIET=$JSON_OUT

# Determine AI command for display
case "${AI_BACKEND:-codex}" in
  codex)  _AI_CMD="${CODEX_CMD:-codex} ${CODEX_ARGS:-exec --color never -}" ;;
  claude) _AI_CMD="${CLAUDE_CMD:-claude} ${CLAUDE_ARGS:--p}" ;;
  *)      _AI_CMD="(unknown)" ;;
esac

# Print config summary (suppressed in --json mode)
if (( ! QUIET )); then
  _flags=""
  (( FULL ))      && _flags+=" --full"
  (( NO_VERIFY )) && _flags+=" --no-verify"
  (( NO_COMMIT )) && _flags+=" --no-commit"
  (( YES ))       && _flags+=" --yes"
  (( TS_ON ))     && _flags+=" --timestamps"
  _flags="${_flags# }"

  step "── git-ai-commit ──"
  info "Backend:   ${AI_BACKEND:-codex}"
  info "Command:   ${_AI_CMD}"
  info "Max chars: ${AI_MAX_CHARS}"
  info "Max tries: ${MAX_ATTEMPTS}"
  info "Log TS:    $([[ $TS_ON -eq 1 ]] && echo 'on (RFC3339 UTC)' || echo 'off')"
  [[ -n "$_flags" ]] && info "Flags:     ${_flags}"
  echo >&2
fi

(( QUIET )) || step "[1/5] Checking working tree & staged changes..."

# Show the working-tree state up front (branch + staged/unstaged/untracked) so
# the operator sees exactly what they are committing against BEFORE any staging
# decision is made. Human view only (stderr via info); suppressed in --json mode.
if (( QUIET == 0 )); then
  _wt_status="$(git status --short --branch 2>/dev/null || true)"
  info "Working tree:"
  if [[ -n "$_wt_status" ]]; then
    while IFS= read -r _wt_line; do
      info "  ${_wt_line}"
    done <<<"$_wt_status"
  else
    info "  (clean)"
  fi
fi

# If nothing staged, offer to stage changes
if git diff --cached --quiet; then
  echo "WARNING: No staged changes detected." >&2

  if git status --porcelain=v1 | grep -q .; then
    echo "You have working-tree changes, but nothing is staged." >&2

    if (( YES == 1 )); then
      echo "Auto-staging all changes due to --yes: git add -A" >&2
      git add -A
      AUTO_STAGED=1
    else
      if confirm_yn "Stage ALL changes with 'git add -A' now? [y/N] "; then
        git add -A
        AUTO_STAGED=1
      else
        die "Nothing staged. Stage changes (e.g., 'git add -A') and re-run."
      fi
    fi
  else
    die "No changes detected. Nothing to commit."
  fi
fi

git diff --cached --quiet && die "Still no staged changes. Nothing to do."

STATUS="$(git status --porcelain=v1 2>/dev/null || true)"
STAGED_FILES="$(git diff --cached --name-status 2>/dev/null || true)"
DIFF="$(git diff --cached --patch 2>/dev/null || true)"

(( QUIET )) || step "[2/5] Scanning ADDED lines for secrets & permission hints..."

# The secret gate scans ADDED lines only. Deletions (leading '-') can neither
# leak a credential to the AI backend nor place one in the new tree — removing a
# secret is a net improvement, not a finding — so scanning them would only raise
# false positives on the very cleanups this tool should encourage. Added lines
# start with a single '+'; the '+++ b/<file>' header is filtered out so a
# filename can never trigger a match. Permission/RBAC hints (prompt context, not
# a gate) still consider the full diff, since a removed grant is relevant too.
ADDED_LINES="$( (git diff --cached | grep -E '^\+' | grep -v -E '^\+\+\+') || true )"
POTENTIAL_SECRETS="$( (printf '%s\n' "$ADDED_LINES" | grep -E -i 'apikey|api_key|secret|token|password|private_key|BEGIN (RSA|OPENSSH) PRIVATE KEY' || true) | head -n 20 )"
PERMISSIONS_HINTS="$( (git diff --cached | grep -E -i 'iam:|policy|role|rbac|clusterrole|serviceaccount|assumeRole|oidc|permissions' || true) | head -n 40 )"

# ---------- blocking secret-scan gate ----------------------------------------
# If the secret-pattern scan matched ANY ADDED line in the staged diff, STOP
# here — BEFORE the prompt is built and BEFORE the backend is called — so matched
# credentials are never transmitted to the external AI backend. This is the
# leak path a prior live run exposed: matches used to be embedded in the prompt.
# Only additions are scanned (see above), so pure deletions of a credential no
# longer trip the gate. --allow-secret-matches overrides the block for confirmed
# false positives; the staged diff (including matched lines) is then sent by the
# user's explicit call. Matched lines are shown to the local operator on stderr
# only; they are never added to the outbound prompt in either path.
if [[ -n "$POTENTIAL_SECRETS" ]]; then
  spinner_maybe_stop
  if (( ALLOW_SECRET_MATCHES == 1 )); then
    {
      echo "WARNING: --allow-secret-matches set — proceeding despite secret-pattern matches."
      echo "WARNING: the staged diff, INCLUDING the matched lines below, will be transmitted"
      echo "         to the AI backend (${AI_BACKEND:-codex}) in plaintext."
      echo "----- POTENTIAL SECRETS IN ADDED LINES -----"
      printf '%s\n' "$POTENTIAL_SECRETS"
      echo "----- END POTENTIAL SECRETS -----"
    } >&2
  else
    {
      echo "----- POTENTIAL SECRETS IN ADDED LINES -----"
      printf '%s\n' "$POTENTIAL_SECRETS"
      echo "----- END POTENTIAL SECRETS -----"
    } >&2
    die "Potential secrets detected in ADDED lines of the staged diff (see block above); refusing to send them to the AI backend.
  Remediate, then re-run:
    - unstage the offending file(s):  git restore --staged <file>   (or: git reset HEAD <file>)
    - add the file(s) to .gitignore if they should never be committed
    - if these are FALSE POSITIVES, re-run with --allow-secret-matches"
  fi
fi

EXTRA_CHECKLIST=""
if (( FULL == 1 )); then
  EXTRA_CHECKLIST=$'
Extra DevSecOps checklist (answer only when evidence exists in the diff):
- AuthN/AuthZ changes? least privilege preserved?
- Secrets: any new secret handling? ensure no hardcoded creds.
- Supply chain: dependency bumps? lockfile changes? provenance?
- CI/CD: pipeline changes? pin versions/SHAs?
- IaC/config: blast radius?
- Logging/PII risk? audit trails?
- Network exposure? ports/TLS changes?
'
fi

OUTPUT_FORMAT_TEXT=$'Output format:\n- First line: Conventional Commit subject (<=72 chars)\n- Blank line\n- Bullets summarizing changes\n- Blank line\n- "Security/DevSecOps Impact:" section (bullets; OR a single line "No security impact — <reason>." when the diff has no security-relevant change)\n- "Testing:" section (bullets)\n\nRules (text mode):\n- Output ONLY the commit message text — it is piped verbatim into `git commit -F -` by non-interactive tooling; there is no conversation and no one to answer questions.\n- No preamble, no postamble, no questions, no offers to act, no commentary about the message itself, and no markdown code fences.\n- Do not cite ADRs, docs, issues, or file contents unless they appear in the provided diff or prompt context. If unsure, omit.\n'

OUTPUT_FORMAT_JSON=$'Output format (JSON only, no markdown, no commentary, no code fences):\n{\n  "subject": "type(scope): subject <= 72 chars",\n  "summary_bullets": ["..."],\n  "security_devsecops_impact": ["..."],\n  "testing": ["..."]\n}\nRules:\n- JSON must be valid.\n- Arrays must contain strings only.\n- Do not invent changes not present in the diff.\n- If you cannot substantiate a security claim from the diff, write \"No evidence in diff\".\n- When the diff has no security-relevant change, "security_devsecops_impact" must be exactly ["No security impact — <one-word reason>."] — do not pad with generic, hypothetical, or unchanged-invariant entries.\n'

(( QUIET )) || step "[3/5] Building prompt..."
spinner_maybe_start "Building prompt…"

# Base prompt is fixed for the whole run (the staged diff does not change between
# regeneration attempts). On a retry, a corrective hint is appended to THIS
# string, not baked in here.
BASE_PROMPT="$(cat <<EOF
Task:
Create a single high-quality *git commit message* for the currently STAGED changes with a DevSecOps mindset.

Context:
- Repo: $(basename "$(git rev-parse --show-toplevel)")
- Branch: $(git rev-parse --abbrev-ref HEAD)

Core requirements:
- Use Conventional Commits: type(scope): subject
- Subject <= 72 chars (no trailing period)
- Body: bullet summary of meaningful changes (group by area if helpful)
- Include sections:
  - Security/DevSecOps Impact:
  - Testing:
- Do not invent changes not present in the diff
- Do not cite ADRs, docs, issues, tickets, or file contents unless they appear in the provided diff or prompt context; if unsure, omit
- If you cannot substantiate a security claim from the diff, say "No evidence in diff" rather than guessing

Security/DevSecOps Impact — calibrate it to THIS diff; do not inflate:
- List an impact only when this diff actually introduces or changes security-relevant behavior: secret handling, authN/authZ, input validation/escaping, network exposure, file permissions, dependencies/supply chain, or logging of sensitive data.
- If the diff has no such change (e.g. documentation, comments, formatting, test-only, or a version/CHANGELOG bump), write exactly one line for the section — "No security impact — <one-word reason>." — and nothing more.
- A change that only documents or describes security rules (rather than enforcing them in code) is documentation-only: say so; do not relist the described rules as impacts.
- Do not pad with generic, hypothetical, or unchanged-invariant statements. Fewer substantiated bullets beat many speculative ones.

Working Tree Status:
${STATUS:-<unknown>}

Staged files (name-status):
${STAGED_FILES:-<none>}

Permissions/IAM/RBAC hints:
${PERMISSIONS_HINTS:-<none>}

Staged unified diff:
$(truncate "${DIFF:-<none>}")

${EXTRA_CHECKLIST}
$(
  if (( JSON_OUT == 1 )); then
    printf "%s" "$OUTPUT_FORMAT_JSON"
  else
    printf "%s" "$OUTPUT_FORMAT_TEXT"
  fi
)
EOF
)"

spinner_maybe_stop

# Dry-run: emit the exact prompt bytes to stdout and stop. stdout is never
# routed through the timestamper, so this is byte-identical regardless of
# AI_LOG_TS / --timestamps — useful for confirming the prompt is unaffected:
#   diff <(AI_LOG_TS=1 git ai-commit --print-prompt) \
#        <(AI_LOG_TS=0 git ai-commit --print-prompt)   # -> no differences
if (( PRINT_PROMPT == 1 )); then
  printf '%s\n' "$BASE_PROMPT"
  exit 0
fi

# Temp files are global so interrupt/exit handlers can clean them up. Created
# once and reused (truncated) across regeneration attempts.
TMP_RAW="$(mktemp)"
TMP_CLEAN="$(mktemp)"

# ---------- generate + validate, with bounded regeneration -------------------
# Ask the backend for a message and validate it (JSON: parseable; TEXT: first
# line is a valid Conventional Commit subject). On a VALIDATION failure we never
# salvage or hand-edit the model's output — instead we REGENERATE, appending a
# corrective hint that names exactly what was wrong, up to MAX_ATTEMPTS times.
# Each retry prints a human-readable banner (_warn_retry) so it is never silent.
# Backend/infra failures (non-zero exit from run_ai, unclean output) are NOT
# retried here: those are environment errors, not malformed messages, so we
# abort immediately with the raw output for diagnosis.
CORRECTION=""
attempt=1
while :; do
  if (( attempt == 1 )); then
    (( QUIET )) || step "[4/5] Calling AI backend (${AI_BACKEND:-codex})..."
  else
    (( QUIET )) || step "[4/5] Calling AI backend (${AI_BACKEND:-codex}), attempt ${attempt}/${MAX_ATTEMPTS}..."
  fi

  PROMPT="$BASE_PROMPT"
  [[ -n "$CORRECTION" ]] && PROMPT="${BASE_PROMPT}"$'\n\n'"${CORRECTION}"

  run_with_wheel_to_file "Calling ${AI_BACKEND:-codex}…" "$TMP_RAW" run_ai "$PROMPT" || {
    AI_RC=$?
    spinner_maybe_stop
    echo "ERROR: AI backend failed (exit code: $AI_RC)." >&2
    echo "----- BEGIN AI OUTPUT -----" >&2
    cat "$TMP_RAW" >&2 || true
    echo "----- END AI OUTPUT -----" >&2
    exit "$AI_RC"
  }

  RAW_OUTPUT="$(cat "$TMP_RAW")"

  run_with_wheel_to_file "Cleaning output…" "$TMP_CLEAN" clean_ai_output "$RAW_OUTPUT" || {
    CLEAN_RC=$?
    spinner_maybe_stop
    echo "ERROR: Failed to clean AI output (exit code: $CLEAN_RC)." >&2
    echo "----- BEGIN RAW OUTPUT -----" >&2
    cat "$TMP_RAW" >&2 || true
    echo "----- END RAW OUTPUT -----" >&2
    exit "$CLEAN_RC"
  }

  CLEAN_OUTPUT="$(cat "$TMP_CLEAN")"

  # ---- validate the generated message (mode-specific) --------------------
  FAIL_REASON=""
  if (( JSON_OUT == 1 )); then
    if printf "%s" "$CLEAN_OUTPUT" | jq -e . >/dev/null 2>&1; then
      # Valid JSON: print JSON only, no auto-commit.
      printf "%s\n" "$CLEAN_OUTPUT"
      exit 0
    fi
    FAIL_REASON="backend output was not valid JSON"
    CORRECTION=$'RETRY — your previous response was rejected: it was not valid JSON.\nReturn ONLY a single valid JSON object matching the schema above — no markdown, no code fences, no commentary.'
  else
    # TEXT mode: strip trailing conversational chatter (warns verbatim on
    # stderr), then require a valid Conventional Commit subject on line 1.
    CLEAN_OUTPUT="$(strip_trailing_chatter "$CLEAN_OUTPUT")"
    _first_line="${CLEAN_OUTPUT%%$'\n'*}"
    if _is_valid_subject "$_first_line"; then
      break   # success — fall through to [5/5] and the commit flow
    fi
    FAIL_REASON="$(_subject_failure_reason "$_first_line")"
    CORRECTION="RETRY — your previous response was rejected: ${FAIL_REASON}."$'\nThe FIRST line MUST be a Conventional Commit subject of the form "type(scope): description" (lowercase type, optional scope, optional trailing exclamation mark), and MUST be <= 72 characters. Output ONLY the commit message — no preamble, no commentary, no code fences.'
  fi

  # ---- validation failed: retry (with a loud banner) or give up ----------
  if (( attempt < MAX_ATTEMPTS )); then
    _warn_retry "$attempt" "$MAX_ATTEMPTS" "$FAIL_REASON"
    attempt=$(( attempt + 1 ))
    continue
  fi

  # Budget exhausted — abort with a clear, human-readable reason and the raw
  # output from the final attempt. No salvage is ever attempted.
  {
    echo "ERROR: Generated commit message failed validation after ${MAX_ATTEMPTS} attempt(s)."
    echo "Reason: ${FAIL_REASON}."
    if (( JSON_OUT == 0 )); then
      echo "Expected first line: a Conventional Commit subject"
      echo "  (/^[a-z]+(\\([^)]*\\))?(!)?: .+/ and <= 72 chars). Got:"
      echo "  ${_first_line}"
    fi
    echo "No salvage attempted. Raw backend output from the final attempt follows:"
    echo "----- BEGIN RAW BACKEND OUTPUT -----"
    printf '%s\n' "$RAW_OUTPUT"
    echo "----- END RAW BACKEND OUTPUT -----"
  } >&2
  # Mirror the abort path below: if we auto-staged, leave the tree as we found it.
  if (( AUTO_STAGED == 1 )); then
    git reset HEAD >/dev/null 2>&1 || true
    echo "Unstaged all auto-staged changes (git reset HEAD)." >&2
  fi
  exit 1
done

(( QUIET )) || step "[5/5] Done."

# Human-readable view
print_commit_block "$CLEAN_OUTPUT"

# Print-only mode
if (( NO_COMMIT == 1 )); then
  exit 0
fi

# Commit confirmation
if (( YES == 0 )); then
  if ! confirm_commit; then
    if (( AUTO_STAGED == 1 )); then
      git reset HEAD >/dev/null 2>&1 || true
      echo "Aborted (no commit created). Unstaged all auto-staged changes." >&2
    else
      echo "Aborted (no commit created)." >&2
    fi
    exit 1
  fi
fi

# Auto-run git commit with the clean message (NO separators)
GIT_ARGS=(commit -F -)
if (( NO_VERIFY == 1 )); then
  GIT_ARGS+=(--no-verify)
fi

printf "%s" "$CLEAN_OUTPUT" | git "${GIT_ARGS[@]}"

# ---------- committed-bytes verification -------------------------------------
# Compare what actually landed in the commit object (git log -1 --format=%B)
# against the message the user approved at the [y/N] prompt (CLEAN_OUTPUT). On a
# match, say so in ONE line — no need to re-print a message the user just
# reviewed. On a MISMATCH (a commit-msg/prepare-commit-msg hook rewrote it, or a
# pipeline bug altered it), warn loudly and print the real committed bytes so
# they are reviewed BEFORE any push. Display only — this never pushes, and the
# exit code stays 0 because the commit already happened. NO_COMMIT=1 exits
# earlier, so this runs only when a commit was actually created. Written to fd 3
# (the raw, un-timestamped stderr) so output is shown verbatim, matching
# print_commit_block's separators.

# _committed_matches_approved <committed> <approved> — returns 0 (match) / 1
# (divergence). ONLY trailing whitespace/newlines are normalized: git normalizes
# the message terminator, so a trailing-newline-only difference is not a real
# divergence. Nothing else is normalized — any interior change counts.
_committed_matches_approved() {
  local committed="$1" approved="$2"
  while [[ "$committed" == *[[:space:]] ]]; do committed="${committed%?}"; done
  while [[ "$approved"  == *[[:space:]] ]]; do approved="${approved%?}"; done
  [[ "$committed" == "$approved" ]]   # RHS quoted -> literal compare, no globbing
}

COMMITTED="$(git log -1 --format=%B || true)"
_verify_line="────────────────────────────────────────────────────────────"

if _committed_matches_approved "$COMMITTED" "$CLEAN_OUTPUT"; then
  printf "%s\n" "Committed bytes verified — match approved message." >&3
else
  _verify_title="WARNING: Committed message does NOT match what you approved"
  _verify_note="A git hook (commit-msg / prepare-commit-msg) most likely rewrote it. Review the actual committed bytes below before pushing."
  if (( COLOR_ON == 1 )); then
    {
      printf "%s\n" "$(c 'setaf 1' "$_verify_line")"
      printf "%s\n" "$(c 'bold' "$_verify_title")"
      printf "%s\n" "$(c 'setaf 8' "$_verify_note")"
      printf "%s\n\n" "$(c 'setaf 1' "$_verify_line")"
      printf "%s\n" "$COMMITTED"
      printf "%s\n" "$(c 'setaf 1' "$_verify_line")"
    } >&3
  else
    {a
      printf "%s\n%s\n%s\n%s\n\n" "$_verify_line" "$_verify_title" "$_verify_note" "$_verify_line"
      printf "%s\n" "$COMMITTED"
      printf "%s\n" "$_verify_line"
    } >&3
  fi
fi
