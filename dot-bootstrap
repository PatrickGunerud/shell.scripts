#!/usr/bin/env bash
set -euo pipefail

# The dot-* family sources its shared lib by the ABSOLUTE path
# "$HOME/bin/lib/dot-common.sh" and calls sibling scripts as "$HOME/bin/dot-*",
# so ~/bin must exist before anything here runs. If you cloned shell.scripts
# elsewhere and ran this script by its full path, ~/bin may not be wired yet --
# detect that here and fail with the fresh-machine ordering, because the source
# line below would otherwise abort with an opaque "No such file or directory".
if [[ ! -e "$HOME/bin/lib/dot-common.sh" ]]; then
  cat >&2 <<'EOM'
ERROR: ~/bin/lib/dot-common.sh not found.

The dot-* tools require shell.scripts installed (or symlinked) at ~/bin.
Fresh-machine setup, in order:

  1. git clone git@github.com:PatrickGunerud/shell.scripts.git \
       ~/repos/github/PatrickGunerud/shell.scripts
  2. ln -s ~/repos/github/PatrickGunerud/shell.scripts ~/bin
     # (or clone shell.scripts directly to ~/bin instead of steps 1-2)
  3. git clone git@github.com:PatrickGunerud/patrick.my.dotfiles.git \
       ~/repos/github/PatrickGunerud/patrick.my.dotfiles
  4. ~/bin/dot-bootstrap

Then re-run dot-bootstrap.
EOM
  exit 1
fi

# shellcheck source=/dev/null
source "$HOME/bin/lib/dot-common.sh"

print_bootstrap_info() {
  cat <<'EOM'

============================================================
 Dotfiles Bootstrap — LINK-ONLY model
============================================================

The dotfiles repo is the SOURCE OF TRUTH. This script wires your
$HOME up to it with symlinks.

Fresh-machine order (the dot-* tools live on $HOME/bin, and the manifest is
itself a managed file, so ordering matters):

  1. Clone shell.scripts (into your repos dir).
  2. Create the ~/bin symlink -> that clone (or clone shell.scripts to ~/bin).
  3. Clone patrick.my.dotfiles (into your repos dir).
  4. Run dot-bootstrap.

Until ~/.dotfiles-manifest is linked, the dot-* tools fall back to the repo copy
at managed/home/.dotfiles-manifest (you'll see a one-line notice); dot-restore
then links the live manifest along with everything else.

Key behaviors:

• For each entry in ~/.dotfiles-manifest, $HOME/<path> becomes a
  SYMLINK to managed/home/<path> in the repo (via dot-restore).
  Editing the live file edits the repo file.

• Any existing real file is moved to:
    ~/.dotfiles-backups/<timestamp>/

• SSH: only PUBLIC keys (*.pub) and config are linked. Private keys
  and anything containing a PRIVATE KEY header are never touched.

• git secret-scan hook: sets core.hooksPath=.githooks in the repo so
  the tracked gitleaks pre-commit hook runs on every commit.

• VS Code settings (IMPORTANT):
  - Canonical file: ~/.vscode/settings.json  (itself a repo symlink)
  - VS Code expects: ~/Library/Application Support/Code/User/settings.json
  - This script symlinks the Library path -> ~/.vscode/settings.json
    Edit ~/.vscode/settings.json (i.e. the repo), never the Library file.

• VS Code extensions: if ~/.vscode/extensions.json exists, its entries
  are installed via the VS Code CLI (if present).

• Safe to re-run — idempotent; existing files are backed up first.
------------------------------------------------------------
EOM
}

setup_hooks_path() {
  if git -C "$DOT_REPO" rev-parse --git-dir >/dev/null 2>&1; then
    git -C "$DOT_REPO" config --local core.hooksPath .githooks
    echo "Set core.hooksPath=.githooks in $DOT_REPO"
    if ! command -v gitleaks >/dev/null 2>&1; then
      echo "WARNING: gitleaks not installed — the pre-commit hook will block commits until you: brew install gitleaks"
    fi
  fi
}

setup_vscode_settings_symlink() {
  local src="$HOME/.vscode/settings.json"
  local dst="$HOME/Library/Application Support/Code/User/settings.json"

  if [[ ! -e "$src" ]]; then
    echo "VS Code settings not found at $src (skipping Library symlink)"
    return 0
  fi

  mkdir -p "$(dirname "$dst")"

  if [[ -e "$dst" && ! -L "$dst" ]]; then
    local backup; backup="$dst.backup.$(date +%Y%m%d-%H%M%S)"
    echo "Backing up existing VS Code settings to:"
    echo "  $backup"
    mv "$dst" "$backup"
  fi

  ln -sf "$src" "$dst"
  echo "VS Code Library settings symlinked:"
  echo "  $dst -> $src"
}

ensure_repo
ensure_manifest

print_bootstrap_info
read -rp "Press Enter to continue (or Ctrl+C to abort)..."

echo ""
echo "Wiring git secret-scan hook..."
setup_hooks_path

echo ""
echo "Linking dotfiles from repo..."
"$HOME/bin/dot-restore" "$@"

echo ""
echo "Setting up VS Code Library settings symlink..."
setup_vscode_settings_symlink

if command -v code >/dev/null 2>&1 && [[ -f "$HOME/.vscode/extensions.json" ]]; then
  if command -v jq >/dev/null 2>&1; then
    echo ""
    echo "Installing VS Code extensions from ~/.vscode/extensions.json..."
    jq -r '.extensions[]? // .recommendations[]?' "$HOME/.vscode/extensions.json" \
      | xargs -n1 code --install-extension
  else
    echo "jq not found; skipping VS Code extension install."
  fi
else
  echo "VS Code CLI (code) not found or ~/.vscode/extensions.json missing; skipping extension install."
fi

echo ""
echo "Bootstrap complete."
