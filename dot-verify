#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=/dev/null
source "$HOME/bin/lib/dot-common.sh"

ensure_repo
ensure_manifest

# LINK-ONLY verification: every managed entry must be a symlink pointing at its
# repo target. Non-zero exit unless every entry is LINK-OK and there are no orphans.
# (LINK-OK implies identical content — the live path and repo file are one inode.)
dot_check_all
