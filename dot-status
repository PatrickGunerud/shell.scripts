#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=/dev/null
source "$HOME/bin/lib/dot-common.sh"

ensure_repo
ensure_manifest

log "Repo: $DOT_REPO"
cd "$DOT_REPO"
git status -sb || true
log ""

# LINK-ONLY link-state report + orphan detection. Non-zero exit unless all LINK-OK.
rc=0
dot_check_all || rc=1

# Scheduled-backup health (result / staleness). Non-zero if failed/missing/stale.
log ""
log "== backup health =="
backup_status_report || rc=1

exit "$rc"
